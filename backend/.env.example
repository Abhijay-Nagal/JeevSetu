# Storage: "local" (SQLite in DATA_DIR, default) or "supabase"
DATA_BACKEND=local
# DATA_DIR=.data

# Optional: enables LLM answers (archive-based fallbacks are used otherwise)
GROQ_API_KEY=

# Set a long random value in production (auto-generated locally otherwise)
AUTH_SECRET=

# Demo content seeded into an empty local store
SEED_DEMO_DATA=true
DEMO_USERNAME=demo_explorer
DEMO_PASSWORD=explore-wildlife

# Only for DATA_BACKEND=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional confirmation email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
APP_PASSWORD=
SMTP_FROM_NAME=JeevSetu
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
